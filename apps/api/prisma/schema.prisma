generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  username         String?           @unique
  displayName      String?
  avatarUrl        String?
  petId            String?
  passwordHash     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projects         Project[]
  sessions         Session[]
  auditLogs        AuditLog[]
  githubConnection GitHubConnection?
  googleConnection GoogleConnection?
  authIdentities   AuthIdentity[]
  artifacts        Artifact[]
  agentSkills      AgentSkill[]
  workflows        Workflow[]
  workflowRuns     WorkflowRun[]
}

model AuthIdentity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([provider, providerSubject])
  @@index([userId])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  workspacePath String    @unique
  repositoryUrl String?
  defaultBranch String    @default("main")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  artifacts     Artifact[]
}

model GitHubConnection {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  installationId String   @unique
  accountLogin   String
  accountType    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GoogleConnection {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail          String
  scopes               String
  accessTokenEncrypted String
  refreshTokenEncrypted String?
  expiresAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Session {
  id               String     @id @default(cuid())
  projectId        String?
  project          Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String     @default("New Session")
  status           String     @default("active")
  selectedModel    String?
  selectedProvider String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  completedAt      DateTime?
  messages         Message[]
  agentRuns        AgentRun[]
  events           Event[]
  artifacts        Artifact[]
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String
  content      String
  metadataJson String?
  status       String   @default("completed")
  createdAt    DateTime @default(now())
}

model AgentRun {
  id           String       @id @default(cuid())
  sessionId    String
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status       String       @default("running")
  goal         String?
  currentStep  String?
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  errorMessage String?
  plans        Plan[]
  toolCalls    ToolCall[]
  fileChanges  FileChange[]
  artifacts    Artifact[]
}

model Plan {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  planJson   String // JSON string
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model ToolCall {
  id               String            @id @default(cuid())
  agentRunId       String
  agentRun         AgentRun          @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  toolName         String
  providerCallId   String?
  argumentsJson    String // JSON string
  resultJson       String?
  riskLevel        String            @default("low")
  approvalStatus   String            @default("auto_approved")
  executionStatus  String            @default("pending")
  startedAt        DateTime?
  completedAt      DateTime?
  exitCode         Int?
  errorMessage     String?
  approvals        Approval[]
  terminalCommands TerminalCommand[]
}

model TerminalCommand {
  id               String    @id @default(cuid())
  toolCallId       String?
  toolCall         ToolCall? @relation(fields: [toolCallId], references: [id], onDelete: SetNull)
  sessionId        String?
  commandDisplay   String
  workingDirectory String
  stdout           String?
  stderr           String?
  exitCode         Int?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
}

model FileChange {
  id         String   @id @default(cuid())
  agentRunId String
  agentRun   AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  path       String
  changeType String
  diff       String?
  createdAt  DateTime @default(now())
}

model Event {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType   String
  payloadJson String // JSON string
  createdAt   DateTime @default(now())
}

model Approval {
  id          String    @id @default(cuid())
  toolCallId  String    @unique
  toolCall    ToolCall  @relation(fields: [toolCallId], references: [id], onDelete: Cascade)
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?
  decision    String?
  reason      String?
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId    String?
  action       String
  metadataJson String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}

// A durable, user-scoped deliverable produced by an agent run: reports,
// spreadsheets, decks, code archives, or deployed-app metadata. Files stay in
// the user's project workspace; this record stores only safe metadata/path.
model Artifact {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sessionId    String?
  session      Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  agentRunId   String?
  agentRun     AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  name         String
  kind         String
  mimeType     String?
  workspacePath String
  sizeBytes    Int?
  status       String    @default("ready")
  metadataJson String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([projectId])
  @@index([sessionId])
}

// Reusable, user-owned agent workflows. Definitions are data, not executable
// code, and are interpreted only by the server-side tool registry.
model AgentSkill {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  definitionJson String
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId, enabled])
}

// A scheduled or manually-triggered orchestration. Secrets/tokens are never
// stored in the definition; integrations are resolved from user connections.
model Workflow {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  name           String
  description    String?
  prompt         String
  triggerType    String        @default("manual")
  schedule       String?
  skillIdsJson   String?
  enabled        Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  runs           WorkflowRun[]

  @@index([userId, enabled])
  @@index([projectId])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentRunId  String?
  status      String    @default("queued")
  triggeredBy String    @default("manual")
  startedAt   DateTime?
  completedAt DateTime?
  errorMessage String?
  createdAt   DateTime  @default(now())

  @@index([workflowId, createdAt])
  @@index([userId, createdAt])
}
