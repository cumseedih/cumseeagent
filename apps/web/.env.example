NEXT_PUBLIC_PRODUCT_NAME="Delvin"
NEXT_PUBLIC_PRODUCT_DOMAIN="delvin.local"
NEXT_PUBLIC_LOGO_PATH="/assets/delvin-logo.jpg"
NEXT_PUBLIC_FAVICON_PATH="/assets/delvin-logo.jpg"
# "H S% L%" channels — drive the whole theme from here
NEXT_PUBLIC_PRIMARY_COLOR="24 5% 18%"
NEXT_PUBLIC_ACCENT_COLOR="48 100% 50%"
NEXT_PUBLIC_HIGHLIGHT_COLOR="48 100% 50%"
NEXT_PUBLIC_HERO_TITLE_LEAD="Experience"
NEXT_PUBLIC_HERO_TITLE_TAIL="the"
NEXT_PUBLIC_HERO_TITLE_HIGHLIGHT="frontier"
# Frontend API base — browser will use this, SSR falls back to relative /api (rewritten via next.config.js)
NEXT_PUBLIC_API_URL="http://localhost:4000"
# Also accepted without NEXT_PUBLIC_ prefix for server-side
PRODUCT_NAME="Delvin"
PRODUCT_DOMAIN="delvin.local"
API_URL="http://127.0.0.1:4000"
