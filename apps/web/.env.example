NEXT_PUBLIC_PRODUCT_NAME="My Agent"
NEXT_PUBLIC_PRODUCT_DOMAIN="localhost"
NEXT_PUBLIC_LOGO_PATH="/assets/logo.svg"
NEXT_PUBLIC_FAVICON_PATH="/assets/favicon.ico"
NEXT_PUBLIC_PRIMARY_COLOR="#0ea5e9"
