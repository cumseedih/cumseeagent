# Root example — real values live in apps/api/.env and apps/web/.env (see those files)
# Copy per-app examples and fill with `openssl rand` values before running.

# API (apps/api/.env.example)
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-please-use-openssl-rand-base64-48"
ENCRYPTION_KEY="change-me-32-hex"

# Web (apps/web/.env.example)
NEXT_PUBLIC_PRODUCT_NAME="My Agent"
NEXT_PUBLIC_API_URL="http://localhost:4000"
